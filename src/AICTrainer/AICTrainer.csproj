<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Version>1.2.2.0</Version>
    <AssemblyVersion>1.2.2.0</AssemblyVersion>
    <FileVersion>1.2.2.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AICShared\AICShared.csproj" />
    <ProjectReference Include="..\AICModPayload\AICModPayload.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*.dll" />
    <Resource Include="Resources\app.ico" />
    <Resource Include="Resources\mascot.png" />
    <Resource Include="Resources\stickers_sheet.png" />
  </ItemGroup>

  <Target Name="CopyPayload" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <PayloadSourcePath Condition="Exists('..\AICModPayload\bin\$(Configuration)\netstandard2.1\AICModPayload.dll')">..\AICModPayload\bin\$(Configuration)\netstandard2.1\AICModPayload.dll</PayloadSourcePath>
      <PayloadSourcePath Condition="'$(PayloadSourcePath)' == '' and Exists('..\AICModPayload\bin\Debug\netstandard2.1\AICModPayload.dll')">..\AICModPayload\bin\Debug\netstandard2.1\AICModPayload.dll</PayloadSourcePath>
    </PropertyGroup>
    <Copy SourceFiles="$(PayloadSourcePath)"
          DestinationFolder="Resources"
          OverwriteReadOnlyFiles="true"
          Condition="'$(PayloadSourcePath)' != ''" />
  </Target>
</Project>
