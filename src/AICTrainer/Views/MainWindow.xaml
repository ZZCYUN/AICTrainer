                            <Border Visibility="{Binding Vis_Lanthanum}" Style="{StaticResource FeatureCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" BorderBrush="#383852" BorderThickness="1" Background="#141420" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Border.Clip>
                                            <RectangleGeometry RadiusX="8" RadiusY="8" Rect="0,0,40,40"/>
                                        </Border.Clip>
                                        <Image Source="{h:Sticker 0_5}" Stretch="UniformToFill"/>
                                    </Border>
                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="强化镧石 (Lanthanum)" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="13"/>
                                                <Border Margin="8,0,0,0" Background="#242436" CornerRadius="6" Padding="6,1">
                                                    <TextBlock Text="{Binding CurrentLanthanumText, StringFormat='当前: {0}'}" Foreground="{StaticResource AccentCyan}" FontSize="11"/>
                                                </Border>
                                            </StackPanel>
                                            <Button HorizontalAlignment="Right" Style="{StaticResource StarButton}" Command="{Binding ToggleFavCommand}" CommandParameter="Lanthanum" Background="{Binding StarBg_Lanthanum}" BorderBrush="{Binding StarBorder_Lanthanum}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StarChar_Lanthanum}" Foreground="{Binding StarColor_Lanthanum}" FontSize="15" FontWeight="Bold" Margin="0,-2,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding StarText_Lanthanum}" Foreground="{Binding StarTextColor_Lanthanum}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="目标: " Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" FontSize="12"/>
                                            <TextBox Grid.Column="1" Width="70" Text="{Binding TargetLanthanum, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="4,0,8,0"/>
                                            <Button Grid.Column="2" HorizontalAlignment="Left" Content="写入数量" Style="{StaticResource ActionButton}" Command="{Binding ApplyLanthanumCommand}"/>
                                            <CheckBox Grid.Column="3" Style="{StaticResource ModernToggleSwitch}" Content="锁定数量" IsChecked="{Binding IsLanthanumLocked}"/>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
