<Window x:Class="AICTrainer.Views.ItemGetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="获取物品"
        Width="680" Height="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentCyan" Color="#00F0FF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B7280"/>

        <!-- 分类筛选胶囊按钮样式 -->
        <Style x:Key="FilterChipButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#181828" BorderBrush="#2A2A3E" BorderThickness="1" CornerRadius="12" Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A2D40"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentCyan}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 获取按钮样式 -->
        <Style x:Key="GetItemButton" TargetType="Button">
            <Setter Property="Background" Value="#102538"/>
            <Setter Property="Foreground" Value="{StaticResource AccentCyan}"/>
            <Setter Property="BorderBrush" Value="#00F0FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#00F0FF"/>
                                <Setter Property="Foreground" Value="#080D14"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#00C4D6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#13131E" BorderBrush="#00F0FF" BorderThickness="1.5" CornerRadius="12" Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#00F0FF" BlurRadius="20" ShadowDepth="0" Opacity="0.35"/>
        </Border.Effect>

        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 标题栏 -->
                <RowDefinition Height="Auto"/> <!-- 搜索框 -->
                <RowDefinition Height="Auto"/> <!-- 分类筛选 -->
                <RowDefinition Height="*"/>    <!-- 物品列表 -->
                <RowDefinition Height="Auto"/> <!-- 数量与星级 -->
                <RowDefinition Height="Auto"/> <!-- 底部栏 -->
            </Grid.RowDefinitions>

            <!-- 1. 标题栏 (可按住拖动) -->
            <Grid Grid.Row="0" Margin="0,0,0,12" MouseLeftButtonDown="OnTitleBarMouseDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" BorderBrush="#00F0FF" BorderThickness="1.5" Background="#14202A" Margin="0,0,10,0">
                        <TextBlock Text="🎒" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="🎒 获取物品" FontSize="16" FontWeight="Bold" Foreground="#F3F4F6"/>
                        <TextBlock x:Name="SubtitleText" Text="载入中..." FontSize="11" Foreground="#9CA3AF"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Width="28" Height="28" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" FontSize="14" Cursor="Hand" Click="OnCloseClick" VerticalAlignment="Top"/>
            </Grid>

            <!-- 2. 搜索框 -->
            <Border Grid.Row="1" Background="#181828" BorderBrush="#2A2A3E" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="#F3F4F6" CaretBrush="{StaticResource AccentCyan}" FontSize="12" VerticalAlignment="Center"
                             TextChanged="OnSearchTextChanged" KeyDown="OnSearchBoxKeyDown"/>
                    <TextBlock Grid.Column="1" x:Name="SearchPlaceholder" Text="搜索物品中文名称或标识 key (如: 血樱桃、料理、mtr_bottle0)..." FontSize="12" Foreground="#6B7280" IsHitTestVisible="False" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" x:Name="ClearSearchBtn" Content="✕" Background="Transparent" BorderThickness="0" Foreground="#9CA3AF" Cursor="Hand" Visibility="Collapsed" Click="OnClearSearchClick" Margin="4,0,0,0"/>
                </Grid>
            </Border>

            <!-- 3. 分类筛选标签栏 -->
            <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                <RadioButton Content="全部物品" IsChecked="True" GroupName="CategoryFilter" Style="{StaticResource FilterChipButton}" Checked="OnCategoryFilterChanged" Tag="ALL"/>
                <RadioButton Content="素材 (MTR)" GroupName="CategoryFilter" Style="{StaticResource FilterChipButton}" Checked="OnCategoryFilterChanged" Tag="MTR"/>
                <RadioButton Content="料理 (FOOD)" GroupName="CategoryFilter" Style="{StaticResource FilterChipButton}" Checked="OnCategoryFilterChanged" Tag="FOOD"/>
                <RadioButton Content="果实 (FRUIT)" GroupName="CategoryFilter" Style="{StaticResource FilterChipButton}" Checked="OnCategoryFilterChanged" Tag="FRUIT"/>
                <RadioButton Content="回复HP (CURE_HP)" GroupName="CategoryFilter" Style="{StaticResource FilterChipButton}" Checked="OnCategoryFilterChanged" Tag="CURE_HP"/>
                <RadioButton Content="回复MP (CURE_MP)" GroupName="CategoryFilter" Style="{StaticResource FilterChipButton}" Checked="OnCategoryFilterChanged" Tag="CURE_MP"/>
                <RadioButton Content="工具 (TOOL)" GroupName="CategoryFilter" Style="{StaticResource FilterChipButton}" Checked="OnCategoryFilterChanged" Tag="TOOL"/>
                <RadioButton Content="炸弹 (BOMB)" GroupName="CategoryFilter" Style="{StaticResource FilterChipButton}" Checked="OnCategoryFilterChanged" Tag="BOMB"/>
                <RadioButton Content="钓鱼 (FOR_FISHING)" GroupName="CategoryFilter" Style="{StaticResource FilterChipButton}" Checked="OnCategoryFilterChanged" Tag="FOR_FISHING"/>
                <RadioButton Content="特殊 (SPECIAL)" GroupName="CategoryFilter" Style="{StaticResource FilterChipButton}" Checked="OnCategoryFilterChanged" Tag="SPECIAL"/>
                <RadioButton Content="其它分类" GroupName="CategoryFilter" Style="{StaticResource FilterChipButton}" Checked="OnCategoryFilterChanged" Tag="OTHER"/>
            </WrapPanel>

            <!-- 4. 物品列表 -->
            <Grid Grid.Row="3">
                <Border Background="#10101A" BorderBrush="#252538" BorderThickness="1" CornerRadius="8" Padding="6">
                    <ListBox x:Name="ItemListBox" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MouseDoubleClick="OnItemDoubleClick"
                             SelectionChanged="OnSelectionChanged"
                             SelectionMode="Extended">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="#161826" BorderBrush="#26283C" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#1C2136"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#1A2D44"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 分类徽标 -->
                                    <Border Grid.Column="0" Background="#241B33" BorderBrush="#A259FF" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding CategoryZh}" Foreground="#D2A8FF" FontSize="10" FontWeight="Medium"/>
                                    </Border>

                                    <!-- 物品信息 -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding PrimaryDisplayName}" FontSize="13" FontWeight="Bold" Foreground="{Binding NameColor}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding KeyDisplay}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                            <TextBlock Text="{Binding OwnedText}" FontSize="11" Foreground="#6EE7B7" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 获取操作按钮 -->
                                    <Button Grid.Column="2" Content="🎁 获取" Style="{StaticResource GetItemButton}" Click="OnGetItemButtonClick" Tag="{Binding Key}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- 空状态提示 -->
                <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="🎒" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock x:Name="EmptyStateText" Text="暂无符合条件的物品" Foreground="#9CA3AF" FontSize="13" HorizontalAlignment="Center"/>
                    <Button Content="🔄 刷新物品列表" Style="{StaticResource GetItemButton}" Margin="0,12,0,0" HorizontalAlignment="Center" Click="OnRefreshItemsClick"/>
                </StackPanel>
            </Grid>

            <!-- 5. 数量与星级 -->
            <Grid Grid.Row="4" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="数量:" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="CountBox" Text="1" Width="44" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                             Background="#181828" BorderBrush="#2A2A3E" BorderThickness="1" Foreground="{StaticResource TextPrimary}"
                             CaretBrush="{StaticResource AccentCyan}" FontSize="12" MaxLength="4" PreviewTextInput="OnCountPreviewTextInput"/>
                    <TextBlock Text="星级:" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="14,0,6,0"/>
                    <RadioButton Content="★1" GroupName="GradeFilter" Style="{StaticResource FilterChipButton}" IsChecked="True" Checked="OnGradeFilterChanged" Tag="0" VerticalAlignment="Center"/>
                    <RadioButton Content="★2" GroupName="GradeFilter" Style="{StaticResource FilterChipButton}" Checked="OnGradeFilterChanged" Tag="1" VerticalAlignment="Center"/>
                    <RadioButton Content="★3" GroupName="GradeFilter" Style="{StaticResource FilterChipButton}" Checked="OnGradeFilterChanged" Tag="2" VerticalAlignment="Center"/>
                    <RadioButton Content="★4" GroupName="GradeFilter" Style="{StaticResource FilterChipButton}" Checked="OnGradeFilterChanged" Tag="3" VerticalAlignment="Center"/>
                    <RadioButton Content="★5" GroupName="GradeFilter" Style="{StaticResource FilterChipButton}" Checked="OnGradeFilterChanged" Tag="4" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="SelectedCountText" Text="已选 0 项" FontSize="12" Foreground="#6EE7B7" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </Grid>

            <!-- 6. 底部按钮栏 -->
            <Grid Grid.Row="5" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="💡 Ctrl/Shift 多选，双击可单条获取；背包满时会掉落/转入屋内仓库"
                           FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="🔄 刷新" Width="64" Height="30" Background="#1E1E2E" Foreground="{StaticResource TextSecondary}" BorderBrush="#383854" BorderThickness="1" Cursor="Hand" Click="OnRefreshItemsClick" Margin="0,0,6,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="全选" Width="56" Height="30" Background="#1E1E2E" Foreground="{StaticResource TextSecondary}" BorderBrush="#383854" BorderThickness="1" Cursor="Hand" Click="OnSelectAllClick" Margin="0,0,6,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="关闭" Width="56" Height="30" Background="#1E1E2E" Foreground="{StaticResource TextSecondary}" BorderBrush="#383854" BorderThickness="1" Cursor="Hand" Click="OnCloseClick" Margin="0,0,6,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="🎁 获取选中" Width="96" Height="30" Style="{StaticResource GetItemButton}" Click="OnGetSelectedClick"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
