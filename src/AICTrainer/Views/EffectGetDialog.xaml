<Window x:Class="AICTrainer.Views.EffectGetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:AICTrainer.Helpers"
        Title="添加效果"
        Width="680" Height="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentCyan" Color="#00F0FF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B7280"/>

        <!-- 星级/筛选胶囊按钮样式 -->
        <Style x:Key="FilterChipButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#181828" BorderBrush="#2A2A3E" BorderThickness="1" CornerRadius="12" Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A2D40"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentCyan}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 添加按钮样式 -->
        <Style x:Key="AddEffectButton" TargetType="Button">
            <Setter Property="Background" Value="#102538"/>
            <Setter Property="Foreground" Value="{StaticResource AccentCyan}"/>
            <Setter Property="BorderBrush" Value="#00F0FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#00F0FF"/>
                                <Setter Property="Foreground" Value="#080D14"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#00C4D6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#13131E" BorderBrush="#00F0FF" BorderThickness="1.5" CornerRadius="12" Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#00F0FF" BlurRadius="20" ShadowDepth="0" Opacity="0.35"/>
        </Border.Effect>

        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 标题栏 -->
                <RowDefinition Height="Auto"/> <!-- 搜索框 -->
                <RowDefinition Height="*"/>    <!-- 效果列表 -->
                <RowDefinition Height="Auto"/> <!-- 时长与等级 -->
                <RowDefinition Height="Auto"/> <!-- 底部栏 -->
            </Grid.RowDefinitions>

            <!-- 1. 标题栏 (可按住拖动) -->
            <Grid Grid.Row="0" Margin="0,0,0,12" MouseLeftButtonDown="OnTitleBarMouseDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" BorderBrush="#00F0FF" BorderThickness="1.5" Background="#14202A" Margin="0,0,10,0">
                        <Border.Clip>
                            <RectangleGeometry RadiusX="8" RadiusY="8" Rect="0,0,36,36"/>
                        </Border.Clip>
                        <Image Source="{h:Sticker 2_5}" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="✨ 添加效果" FontSize="16" FontWeight="Bold" Foreground="#F3F4F6"/>
                        <TextBlock x:Name="SubtitleText" Text="载入中..." FontSize="11" Foreground="#9CA3AF"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Width="28" Height="28" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" FontSize="14" Cursor="Hand" Click="OnCloseClick" VerticalAlignment="Top"/>
            </Grid>

            <!-- 2. 搜索框 -->
            <Border Grid.Row="1" Background="#181828" BorderBrush="#2A2A3E" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="#F3F4F6" CaretBrush="{StaticResource AccentCyan}" FontSize="12" VerticalAlignment="Center"
                             TextChanged="OnSearchTextChanged" KeyDown="OnSearchBoxKeyDown"/>
                    <TextBlock Grid.Column="1" x:Name="SearchPlaceholder" Text="搜索效果中文名或枚举名 (如: 中毒、攻击力上升、POISON)..." FontSize="12" Foreground="#6B7280" IsHitTestVisible="False" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" x:Name="ClearSearchBtn" Content="✕" Background="Transparent" BorderThickness="0" Foreground="#9CA3AF" Cursor="Hand" Visibility="Collapsed" Click="OnClearSearchClick" Margin="4,0,0,0"/>
                </Grid>
            </Border>

            <!-- 3. 效果列表 -->
            <Grid Grid.Row="2">
                <Border Background="#10101A" BorderBrush="#252538" BorderThickness="1" CornerRadius="8" Padding="6">
                    <ListBox x:Name="EffectListBox" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MouseDoubleClick="OnEffectDoubleClick"
                             SelectionChanged="OnSelectionChanged"
                             SelectionMode="Extended"
                             VirtualizingPanel.IsVirtualizing="False">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="#161826" BorderBrush="#26283C" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#1C2136"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#1A2D44"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <!-- 折叠组内的等级行：默认收起，仅组头展开时显示 -->
                                    <DataTrigger Binding="{Binding Group.IsExpanded}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Group.IsExpanded}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <!-- 组头行样式 -->
                                    <DataTrigger Binding="{Binding IsGroupHeader}" Value="True">
                                        <Setter Property="Cursor" Value="Hand"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 效果信息 -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Bold" Foreground="{Binding NameColor}"/>
                                        <TextBlock Text="{Binding KeyDisplay}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- 添加/展开操作按钮 -->
                                    <Button Grid.Column="1" Click="OnAddEffectButtonClick" Tag="{Binding}" VerticalAlignment="Center">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource AddEffectButton}">
                                                <Setter Property="Content" Value="✨ 添加"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGroupHeader}" Value="True">
                                                        <Setter Property="Content" Value="{Binding ExpandCollapseText}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- 空状态提示 -->
                <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="🔮" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock x:Name="EmptyStateText" Text="暂无符合条件的效果" Foreground="#9CA3AF" FontSize="13" HorizontalAlignment="Center"/>
                    <Button Content="🔄 刷新效果列表" Style="{StaticResource AddEffectButton}" Margin="0,12,0,0" HorizontalAlignment="Center" Click="OnRefreshEffectsClick"/>
                </StackPanel>
            </Grid>

            <!-- 4. 时长与等级 -->
            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="时长(秒):" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="DurationBox" Text="30" Width="52" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                             Background="#181828" BorderBrush="#2A2A3E" BorderThickness="1" Foreground="{StaticResource TextPrimary}"
                             CaretBrush="{StaticResource AccentCyan}" FontSize="12" MaxLength="4" PreviewTextInput="OnDurationPreviewTextInput"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="SelectedCountText" Text="已选 0 项" FontSize="12" Foreground="#6EE7B7" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </Grid>

            <!-- 5. 底部按钮栏 -->
            <Grid Grid.Row="4" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="💡 Ctrl/Shift 多选 · 双击单条 · 同效果多等级按最高级添加 · 无等级效果只显示原名"
                           FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="🔄 刷新" Width="64" Height="30" Background="#1E1E2E" Foreground="{StaticResource TextSecondary}" BorderBrush="#383854" BorderThickness="1" Cursor="Hand" Click="OnRefreshEffectsClick" Margin="0,0,6,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="全选" Width="56" Height="30" Background="#1E1E2E" Foreground="{StaticResource TextSecondary}" BorderBrush="#383854" BorderThickness="1" Cursor="Hand" Click="OnSelectAllClick" Margin="0,0,6,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="关闭" Width="56" Height="30" Background="#1E1E2E" Foreground="{StaticResource TextSecondary}" BorderBrush="#383854" BorderThickness="1" Cursor="Hand" Click="OnCloseClick" Margin="0,0,6,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="✨ 添加选中" Width="96" Height="30" Style="{StaticResource AddEffectButton}" Click="OnAddSelectedClick"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
