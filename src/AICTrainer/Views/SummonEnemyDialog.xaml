<Window x:Class="AICTrainer.Views.SummonEnemyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:AICTrainer.Helpers"
        Title="召唤魔物"
        Width="750" Height="720"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentCyan" Color="#00F0FF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B7280"/>

        <!-- 分类/选项筛选胶囊按钮样式 -->
        <Style x:Key="FilterChipButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#181828" BorderBrush="#2A2A3E" BorderThickness="1" CornerRadius="12" Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A2D40"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentCyan}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 属性复选胶囊样式 -->
        <Style x:Key="AttrChipCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="bd" Background="#181828" BorderBrush="#2A2A3E" BorderThickness="1" CornerRadius="12" Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A2D40"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentCyan}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 召唤主按钮样式 -->
        <Style x:Key="SummonActionButton" TargetType="Button">
            <Setter Property="Background" Value="#102538"/>
            <Setter Property="Foreground" Value="{StaticResource AccentCyan}"/>
            <Setter Property="BorderBrush" Value="#00F0FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#00F0FF"/>
                                <Setter Property="Foreground" Value="#080D14"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#00C4D6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#13131E" BorderBrush="#00F0FF" BorderThickness="1.5" CornerRadius="12" Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#00F0FF" BlurRadius="20" ShadowDepth="0" Opacity="0.35"/>
        </Border.Effect>

        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0. 标题栏 -->
                <RowDefinition Height="Auto"/> <!-- 1. 搜索框 -->
                <RowDefinition Height="Auto"/> <!-- 2. 分类筛选 -->
                <RowDefinition Height="*"/>    <!-- 3. 魔物列表 -->
                <RowDefinition Height="Auto"/> <!-- 4. 自定义属性面板 -->
                <RowDefinition Height="Auto"/> <!-- 5. 底部栏 -->
            </Grid.RowDefinitions>

            <!-- 0. 标题栏 (按住拖动) -->
            <Grid Grid.Row="0" Margin="0,0,0,10" MouseLeftButtonDown="OnTitleBarMouseDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" BorderBrush="#00F0FF" BorderThickness="1.5" Background="#14202A" Margin="0,0,10,0">
                        <Border.Clip>
                            <RectangleGeometry RadiusX="8" RadiusY="8" Rect="0,0,36,36"/>
                        </Border.Clip>
                        <Image Source="{h:Sticker 3_3}" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="👹 召唤魔物" FontSize="16" FontWeight="Bold" Foreground="#F3F4F6"/>
                        <TextBlock x:Name="SubtitleText" Text="载入中..." FontSize="11" Foreground="#9CA3AF"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Width="28" Height="28" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" FontSize="14" Cursor="Hand" Click="OnCloseClick" VerticalAlignment="Top"/>
            </Grid>

            <!-- 1. 搜索框 -->
            <Border Grid.Row="1" Background="#181828" BorderBrush="#2A2A3E" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="#F3F4F6" CaretBrush="{StaticResource AccentCyan}" FontSize="12" VerticalAlignment="Center"
                             TextChanged="OnSearchTextChanged" KeyDown="OnSearchBoxKeyDown"/>
                    <TextBlock Grid.Column="1" x:Name="SearchPlaceholder" Text="搜索魔物中文名称或标识 key (如: 史莱姆、石巨人、SLIME_0、BOSS)..." FontSize="12" Foreground="#6B7280" IsHitTestVisible="False" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" x:Name="ClearSearchBtn" Content="✕" Background="Transparent" BorderThickness="0" Foreground="#9CA3AF" Cursor="Hand" Visibility="Collapsed" Click="OnClearSearchClick" Margin="4,0,0,0"/>
                </Grid>
            </Border>

            <!-- 2. 分类筛选标签栏 -->
            <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                <RadioButton Content="全部魔物" IsChecked="True" GroupName="CategoryFilter" Style="{StaticResource FilterChipButton}" Checked="OnCategoryFilterChanged" Tag="ALL"/>
                <RadioButton Content="普通魔物" GroupName="CategoryFilter" Style="{StaticResource FilterChipButton}" Checked="OnCategoryFilterChanged" Tag="NORMAL"/>
                <RadioButton Content="首领 BOSS" GroupName="CategoryFilter" Style="{StaticResource FilterChipButton}" Checked="OnCategoryFilterChanged" Tag="BOSS"/>
                <RadioButton Content="机械魔物" GroupName="CategoryFilter" Style="{StaticResource FilterChipButton}" Checked="OnCategoryFilterChanged" Tag="MACHINE"/>
            </WrapPanel>

            <!-- 3. 魔物列表 -->
            <Grid Grid.Row="3">
                <Border Background="#10101A" BorderBrush="#252538" BorderThickness="1" CornerRadius="8" Padding="6">
                    <ListBox x:Name="EnemyListBox" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MouseDoubleClick="OnEnemyDoubleClick"
                             SelectionChanged="OnSelectionChanged"
                             SelectionMode="Single">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="#161826" BorderBrush="#26283C" BorderThickness="1" CornerRadius="6" Padding="10,7">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#1C2136"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#1A2D44"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 分类徽标 -->
                                    <Border Grid.Column="0" Background="{Binding CategoryBgColor}" BorderBrush="{Binding CategoryBorderColor}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding CategoryZh}" Foreground="{Binding CategoryTextColor}" FontSize="10" FontWeight="Medium"/>
                                    </Border>

                                    <!-- 魔物信息 -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Bold" Foreground="{Binding NameColor}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding KeyDisplay}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                            <TextBlock Text="{Binding StatsDisplay}" FontSize="11" Foreground="#6EE7B7" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 行级快捷召唤按钮 -->
                                    <Button Grid.Column="2" Content="👹 召唤" Style="{StaticResource SummonActionButton}" Click="OnSummonButtonClick" Tag="{Binding}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- 空状态提示 -->
                <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="👹" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock x:Name="EmptyStateText" Text="暂无符合条件的魔物" Foreground="#9CA3AF" FontSize="13" HorizontalAlignment="Center"/>
                    <Button Content="🔄 刷新魔物列表" Style="{StaticResource SummonActionButton}" Margin="0,12,0,0" HorizontalAlignment="Center" Click="OnRefreshEnemiesClick"/>
                </StackPanel>
            </Grid>

            <!-- 4. 自定义属性面板 -->
            <Border Grid.Row="4" Background="#151522" BorderBrush="#26263A" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,8,0,0">
                <StackPanel>
                    <!-- 4.1 元素与状态属性 (ENATTR) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock Text="元素与特征 (ENATTR):" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="可自由多选组合" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <WrapPanel Margin="0,0,0,4">
                        <CheckBox x:Name="AttrFireCheck" Content="🔥 火属性 (FIRE)" Style="{StaticResource AttrChipCheckBox}" Tag="256"/>
                        <CheckBox x:Name="AttrIceCheck" Content="❄️ 冰属性 (ICE)" Style="{StaticResource AttrChipCheckBox}" Tag="512"/>
                        <CheckBox x:Name="AttrThunderCheck" Content="⚡ 雷属性 (THUNDER)" Style="{StaticResource AttrChipCheckBox}" Tag="1024"/>
                        <CheckBox x:Name="AttrSlimyCheck" Content="🧪 粘液 (SLIMY)" Style="{StaticResource AttrChipCheckBox}" Tag="2048"/>
                        <CheckBox x:Name="AttrAcmeCheck" Content="💜 绝顶 (ACME)" Style="{StaticResource AttrChipCheckBox}" Tag="4096"/>
                        <CheckBox x:Name="AttrBigCheck" Content="🐘 巨大化 (BIG)" Style="{StaticResource AttrChipCheckBox}" Tag="131072"/>
                        <CheckBox x:Name="AttrInvisibleCheck" Content="👻 隐形 (INVISIBLE)" Style="{StaticResource AttrChipCheckBox}" Tag="65536"/>
                        <CheckBox x:Name="AttrAtkCheck" Content="⚔️ 攻击特化 (ATK)" Style="{StaticResource AttrChipCheckBox}" Tag="1"/>
                        <CheckBox x:Name="AttrDefCheck" Content="🛡️ 防御特化 (DEF)" Style="{StaticResource AttrChipCheckBox}" Tag="2"/>
                        <CheckBox x:Name="AttrMpStableCheck" Content="💧 MP安定 (MP_STABLE)" Style="{StaticResource AttrChipCheckBox}" Tag="4"/>
                    </WrapPanel>

                    <!-- 4.2 狂暴与木桩模式开关 -->
                    <Grid Margin="0,4,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="OverDriveCheck" Content="🔥 开启狂暴 (OverDrive)" Style="{StaticResource AttrChipCheckBox}" Margin="0,0,12,0" ToolTip="直接激活魔物狂暴 AI 与特效姿态"/>
                            <CheckBox x:Name="DummyCheck" Content="🪵 木桩模式 (原地静止/不攻击)" Style="{StaticResource AttrChipCheckBox}" Margin="0,0,12,0" ToolTip="锁定移动与跳跃，方便测试连招与技能伤害"/>
                        </StackPanel>
                    </Grid>

                    <!-- 4.3 生成位置、数量与生命倍率 -->
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 生成位置 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="生成位置:" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <RadioButton Content="身前" GroupName="PosMode" Style="{StaticResource FilterChipButton}" IsChecked="True" Tag="0" ToolTip="玩家前方2.5格地面"/>
                            <RadioButton Content="身后" GroupName="PosMode" Style="{StaticResource FilterChipButton}" Tag="1" ToolTip="玩家后方2.5格"/>
                            <RadioButton Content="正上方" GroupName="PosMode" Style="{StaticResource FilterChipButton}" Tag="2" ToolTip="玩家头顶上方3格"/>
                            <RadioButton Content="身边脚下" GroupName="PosMode" Style="{StaticResource FilterChipButton}" Tag="3" ToolTip="玩家脚下"/>
                            <RadioButton Content="周围随机" GroupName="PosMode" Style="{StaticResource FilterChipButton}" Tag="4" ToolTip="玩家周围随机分布"/>
                        </StackPanel>

                        <!-- 生成数量 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="数量:" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Button Content="-" Width="22" Height="24" Background="#1E1E2E" Foreground="{StaticResource TextSecondary}" BorderBrush="#383854" BorderThickness="1" Cursor="Hand" Click="OnCountDecClick"/>
                            <TextBox x:Name="CountBox" Text="1" Width="36" Height="24" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                     Background="#181828" BorderBrush="#2A2A3E" BorderThickness="1" Foreground="{StaticResource TextPrimary}"
                                     CaretBrush="{StaticResource AccentCyan}" FontSize="11" MaxLength="2" PreviewTextInput="OnCountPreviewTextInput"/>
                            <Button Content="+" Width="22" Height="24" Background="#1E1E2E" Foreground="{StaticResource TextSecondary}" BorderBrush="#383854" BorderThickness="1" Cursor="Hand" Click="OnCountIncClick"/>
                        </StackPanel>

                        <!-- 生命倍率 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="HP倍率:" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="HpMultBox" Text="1.0" Width="44" Height="24" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                     Background="#181828" BorderBrush="#2A2A3E" BorderThickness="1" Foreground="{StaticResource TextPrimary}"
                                     CaretBrush="{StaticResource AccentCyan}" FontSize="11" MaxLength="5" PreviewTextInput="OnHpMultPreviewTextInput"/>
                            <RadioButton Content="1x" GroupName="HpMultPreset" Style="{StaticResource FilterChipButton}" IsChecked="True" Checked="OnHpMultPresetChecked" Tag="1.0" Margin="4,0,2,0"/>
                            <RadioButton Content="2x" GroupName="HpMultPreset" Style="{StaticResource FilterChipButton}" Checked="OnHpMultPresetChecked" Tag="2.0" Margin="0,0,2,0"/>
                            <RadioButton Content="5x" GroupName="HpMultPreset" Style="{StaticResource FilterChipButton}" Checked="OnHpMultPresetChecked" Tag="5.0" Margin="0,0,2,0"/>
                            <RadioButton Content="10x" GroupName="HpMultPreset" Style="{StaticResource FilterChipButton}" Checked="OnHpMultPresetChecked" Tag="10.0" Margin="0,0,2,0"/>
                            <RadioButton Content="100x" GroupName="HpMultPreset" Style="{StaticResource FilterChipButton}" Checked="OnHpMultPresetChecked" Tag="100.0" Margin="0,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 5. 底部栏 -->
            <Grid Grid.Row="5" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="💡 双击列表直接召唤 · 支持多种属性组合 · 需在关卡地图内生效"
                           FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="🔄 刷新" Width="64" Height="30" Background="#1E1E2E" Foreground="{StaticResource TextSecondary}" BorderBrush="#383854" BorderThickness="1" Cursor="Hand" Click="OnRefreshEnemiesClick" Margin="0,0,6,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="重置属性" Width="68" Height="30" Background="#1E1E2E" Foreground="{StaticResource TextSecondary}" BorderBrush="#383854" BorderThickness="1" Cursor="Hand" Click="OnResetAttrsClick" Margin="0,0,6,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="关闭" Width="56" Height="30" Background="#1E1E2E" Foreground="{StaticResource TextSecondary}" BorderBrush="#383854" BorderThickness="1" Cursor="Hand" Click="OnCloseClick" Margin="0,0,6,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="👹 立即召唤" Width="96" Height="30" Style="{StaticResource SummonActionButton}" Click="OnSummonSelectedClick"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
