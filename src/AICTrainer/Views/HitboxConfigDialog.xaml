<Window x:Class="AICTrainer.Views.HitboxConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:AICTrainer.Helpers"
        Title="判定框显示条目配置"
        Width="490" Height="450"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentCyan" Color="#00F0FF"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#38BDF8"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FB7185"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="BorderDark" Color="#2A2A3E"/>

        <!-- 滑动开关 ToggleSwitch 样式 -->
        <Style x:Key="ModernToggleSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="40" Height="20" Margin="0,0,8,0">
                                <Border x:Name="Track" Background="#2B2B3D" CornerRadius="10" BorderBrush="#3D3D56" BorderThickness="1"/>
                                <Ellipse x:Name="Thumb" Width="14" Height="14" HorizontalAlignment="Left" Margin="3,0,0,0" Fill="#8E8EA8">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.4"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#00C4D6"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#00F0FF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#13131E" BorderBrush="#00F0FF" BorderThickness="1.5" CornerRadius="12" Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#00F0FF" BlurRadius="20" ShadowDepth="0" Opacity="0.35"/>
        </Border.Effect>

        <Grid Margin="20,18,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 标题栏 -->
                <RowDefinition Height="*"/>    <!-- 内容选项区 -->
                <RowDefinition Height="Auto"/> <!-- 底部按钮 -->
            </Grid.RowDefinitions>

            <!-- 1. 标题栏 -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" BorderBrush="#00F0FF" BorderThickness="1.5" Background="#14202A" Margin="0,0,10,0">
                        <Border.Clip>
                            <RectangleGeometry RadiusX="8" RadiusY="8" Rect="0,0,36,36"/>
                        </Border.Clip>
                        <Image Source="{h:Sticker 3_1}" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="判定框展示条目配置" FontSize="16" FontWeight="Bold" Foreground="#F3F4F6"/>
                        <TextBlock Text="独立控制游戏中受击框（蓝）与攻击框（红）渲染的具体内容" FontSize="11" Foreground="#9CA3AF"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Width="28" Height="28" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" FontSize="14" Cursor="Hand" Click="OnCloseClick" VerticalAlignment="Top"/>
            </Grid>

            <!-- 2. 内容选项区 -->
            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                <!-- 受击判定框 (蓝框) 配置板块 -->
                <Border Background="#161828" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="🛡️ 受击框 (蓝框) 显示条目" Foreground="#60A5FA" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Text="（支持 1~3 行自由组合）" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="6,1,0,0"/>
                        </StackPanel>
                        
                        <!-- 第 1 行：单位名称 -->
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="显示单位名称 (第 1 行)" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="Noel 或 [EN] 敌怪名称" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ModernToggleSwitch}" IsChecked="{Binding IsHitboxShowName}"/>
                        </Grid>

                        <Separator Background="#222438" Margin="0,4,0,4"/>

                        <!-- 第 2 行：HP -->
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="显示生命值 (第 2 行)" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="HP: 当前值 / 最大值" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ModernToggleSwitch}" IsChecked="{Binding IsHitboxShowHp}"/>
                        </Grid>

                        <Separator Background="#222438" Margin="0,4,0,4"/>

                        <!-- 第 3 行：MP -->
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="显示法力值 (第 3 行)" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="MP: 当前值 / 最大值（仅具有 MP 机制的单位展示）" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ModernToggleSwitch}" IsChecked="{Binding IsHitboxShowMp}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 攻击判定框 (红框) 配置板块 -->
                <Border Background="#20151E" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="8" Padding="14,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="⚔️ 攻击判定框 (红框) 显示条目" Foreground="#F87171" FontWeight="Bold" FontSize="13"/>
                        </StackPanel>

                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="显示攻击判定信息 (单行)" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="[ATK] 种类 (释放者名称)；关闭后仅绘制红色范围框体" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ModernToggleSwitch}" IsChecked="{Binding IsHitboxShowAtkInfo}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 3. 底部确定按钮 -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="💡 修改后即时生效，开启「保存配置」时将自动持久化保存" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="确定并关闭" Width="110" Height="32" Click="OnCloseClick">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#172B23"/>
                            <Setter Property="Foreground" Value="#B9F6CA"/>
                            <Setter Property="BorderBrush" Value="#00E676"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#224436"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#69F0AE"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
