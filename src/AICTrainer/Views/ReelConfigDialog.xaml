<Window x:Class="AICTrainer.Views.ReelConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:AICTrainer.Helpers"
        Title="宝箱轮盘高级配置"
        Width="510" Height="475"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentCyan" Color="#00F0FF"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#38BDF8"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="BorderDark" Color="#2A2A3E"/>

        <Style x:Key="ModernToggleSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="40" Height="20" Margin="0,0,8,0">
                                <Border x:Name="Track" Background="#2B2B3D" CornerRadius="10" BorderBrush="#3D3D56" BorderThickness="1"/>
                                <Ellipse x:Name="Thumb" Width="14" Height="14" HorizontalAlignment="Left" Margin="3,0,0,0" Fill="#8E8EA8">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.4"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#00C4D6"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#00F0FF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#13131E" BorderBrush="#00F0FF" BorderThickness="1.5" CornerRadius="12" Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#00F0FF" BlurRadius="20" ShadowDepth="0" Opacity="0.35"/>
        </Border.Effect>

        <Grid Margin="20,18,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. 标题栏 -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" BorderBrush="#00F0FF" BorderThickness="1.5" Background="#14202A" Margin="0,0,10,0">
                        <Border.Clip>
                            <RectangleGeometry RadiusX="8" RadiusY="8" Rect="0,0,36,36"/>
                        </Border.Clip>
                        <Image Source="{h:Sticker 0_7}" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="宝箱轮盘高级配置" FontSize="16" FontWeight="Bold" Foreground="#F3F4F6"/>
                        <TextBlock Text="定制开箱转盘的滚动速度、自动化决策与强化词条优先逻辑" FontSize="11" Foreground="#9CA3AF"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Width="28" Height="28" Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" FontSize="14" Cursor="Hand" Click="OnCloseClick" VerticalAlignment="Top"/>
            </Grid>

            <!-- 2. 内容选项区 -->
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <!-- 选项 1：首轮自动选择 -->
                <Border Background="#161828" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="🎯 首轮自动选择" Foreground="#60A5FA" FontWeight="Bold" FontSize="13"/>
                                <Border Margin="8,0,0,0" Background="#1E3A8A" CornerRadius="4" Padding="5,1">
                                    <TextBlock Text="自动锁最优" Foreground="#93C5FD" FontSize="10"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="首轮物品抽取盘自动判定并停在最高稀有度/独占道具槽位；关闭后需玩家手动停盘" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ModernToggleSwitch}" IsChecked="{Binding IsReelFirstAutoDecide}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 选项 2：首轮慢速 -->
                <Border Background="#141E28" BorderBrush="#0D9488" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="🐌 首轮慢速" Foreground="#2DD4BF" FontWeight="Bold" FontSize="13"/>
                                <Border Margin="8,0,0,0" Background="#134E4A" CornerRadius="4" Padding="5,1">
                                    <TextBlock Text="降低转速5倍" Foreground="#99F6E4" FontSize="10"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="首轮物品抽取盘转速放慢约 5 倍，便于清晰看清候选道具并从容手动停盘" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ModernToggleSwitch}" IsChecked="{Binding IsReelFirstSlow}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 选项 3：加成轮减速 -->
                <Border Background="#201C18" BorderBrush="#D97706" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="⏱️ 加成轮减速" Foreground="#FBBF24" FontWeight="Bold" FontSize="13"/>
                                <Border Margin="8,0,0,0" Background="#78350F" CornerRadius="4" Padding="5,1">
                                    <TextBlock Text="降低转速5倍" Foreground="#FDE68A" FontSize="10"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="后续品质升级与词条轮盘转速放慢约 5 倍，方便看清各加成槽位手动把控时机" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ModernToggleSwitch}" IsChecked="{Binding IsReelBonusSlow}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 选项 4：加成轮自动选择 -->
                <Border Background="#1A1828" BorderBrush="#7C3AED" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="⚡ 加成轮自动选择" Foreground="#A78BFA" FontWeight="Bold" FontSize="13"/>
                                <Border Margin="8,0,0,0" Background="#3B0764" CornerRadius="4" Padding="5,1">
                                    <TextBlock Text="智能锁定最优" Foreground="#DDD6FE" FontSize="10"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="后续升级轮盘自动锁定最高加成（满5★优先数量翻倍，未满星优先升星）；关闭后手动停盘" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ModernToggleSwitch}" IsChecked="{Binding IsReelBonusAutoDecide}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 3. 底部确定按钮 -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="💡 实时生效，开启「保存配置」时将自动持久化记忆" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="确定并关闭" Width="110" Height="32" Click="OnCloseClick">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#172B23"/>
                            <Setter Property="Foreground" Value="#B9F6CA"/>
                            <Setter Property="BorderBrush" Value="#00E676"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#224436"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#69F0AE"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
